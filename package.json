{
  "name": "venus-influx-loader",
  "version": "1.0.0",
  "description": ".",
  "type": "module",
  "scripts": {
    "prebuild": "./generateBuildInfo.sh",
    "build:bin": "tsc -p tsconfig.build.json",
    "postbuild:bin": "chmod +x dist/bin/*.js",
    "build:client": "vite build",
    "build": "npm run build:bin && npm run build:client",
    "clean": "rimraf ./dist",
    "lint": "eslint . --fix",
    "type-check": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json",
    "watch:bin": "tsc -p tsconfig.build.json --watch",
    "watch-client": "vite",
    "watch-influx-loader": "concurrently npm:watch:bin \"node --watch dist/bin/venus-influx-loader.js -- --config-path ./config/ --port 8088\"",
    "watch-upnp-browser": "concurrently npm:watch:bin \"node --watch dist/bin/venus-upnp-browser.js\"",
    "start": "VIL_INFLUXDB_URL=http://localhost:8086 VIL_INFLUXDB_USERNAME=s3cr4t VIL_INFLUXDB_PASSWORD=s3cr4t concurrently npm:watch-influx-loader npm:watch-client",
    "prepare": "(husky || true) && npm run prebuild",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/victronenergy/venus-influx-loader.git"
  },
  "bugs": {
    "url": "https://github.com/victronenergy/venus-influx-loader/issues"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "npm run lint"
  },
  "bin": {
    "venus-influx-loader": "./dist/bin/venus-influx-loader.js",
    "venus-upnp-browser": "./dist/bin/venus-upnp-browser.js"
  },
  "author": "Scott Bender <scott@scottbender.net>",
  "contributors": [
    "Martin Man <mman@martinman.net>"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.x <=24.x"
  },
  "files": [
    "src",
    "bin",
    "dist"
  ],
  "dependencies": {
    "axios": "^1.20.0",
    "basic-auth": "^2.0.1",
    "body-parser": "^2.3.0",
    "commander": "^15.0.0",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "influx": "^5.12.0",
    "lodash": "^4.18.1",
    "mqtt": "^5.15.2",
    "ms": "^2.1.3",
    "node-ssdp": "^4.0.1",
    "primus": "^8.0.9",
    "tsscmp": "^1.0.6",
    "winston": "^3.19.0",
    "ws": "^8.21.3",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@coreui/coreui": "^5.9.0",
    "@coreui/icons": "^3.1.0",
    "@coreui/icons-react": "^2.3.0",
    "@coreui/react": "^5.13.0",
    "@eslint/js": "^10.0.1",
    "@popperjs/core": "^2.11.8",
    "@types/basic-auth": "^1.1.8",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.25",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.2.0",
    "@types/node-ssdp": "^4.0.5",
    "@types/primus": "^7.3.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tsscmp": "^1.0.2",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^6.1.1",
    "axios-hooks": "^5.1.1",
    "concurrently": "^10.0.5",
    "confusing-browser-globals": "^1.0.11",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "rimraf": "^6.1.3",
    "sass": "^1.104.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
